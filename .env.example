# Copy to .env (git-ignored); loaded by dotenv-rails for both web and Sidekiq.
# Which agent CLI runs workflows: claude | cursor | codex
AGENT=claude
# Set to 1 for incremental stream-json logs (claude only)
# AI_VERBOSE=1
# REDIS_URL=redis://localhost:6379/0
JIRA_ACCESS_TOKEN=xxxxxxx
JIRA_EMAIL=hoang@netengine.com.au
# Optional: pin Active Record encryption keys (Project#uat_password). `bin/rails db:encryption:init` prints values.
# Without them the keys are derived from secret_key_base (rotating it makes saved UAT passwords unreadable).
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# JIRA_EMAIL / JIRA_ACCESS_TOKEN above are also used by the UAT test to attach video/trace to tickets.
# Optional: Slack bot token (chat:write, bot invited to the channel) to ping reviewers when a PR is ready; set the channel per project.
# SLACK_BOT_TOKEN=xoxb-...
