<div class="page-header">
  <h2>Jira syncs</h2>
  <div class="page-header__actions">
    <%= link_to "New sync", new_project_jira_sync_path(project), class: "btn btn-primary" %>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Scope</th>
        <th>Auto</th>
        <th>Last synced</th>
        <th>Last result</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% project.jira_syncs.order(:id).each do |sync| %>
        <tr>
          <td><%= sync.label %></td>
          <td><%= sync.auto_sync? ? "Yes" : "No" %></td>
          <td class="text-muted"><%= time_ago_or_never(sync.last_synced_at) %></td>
          <td class="text-muted"><%= sync.last_result %></td>
          <td>
            <%= inline_button_to "Sync now", run_project_jira_sync_path(project, sync), class: "link-action" %>
            <%= link_to "Edit", edit_project_jira_sync_path(project, sync), class: "link-action" %>
            <%= delete_link_to "Delete", project_jira_sync_path(project, sync), class: "link-danger", confirm: "Delete this sync?" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if project.jira_syncs.empty? %>
    <div class="empty-state">No syncs yet. <%= link_to "Add one", new_project_jira_sync_path(project) %> to pull assigned tickets from a Jira project or parent ticket.</div>
  <% end %>
</div>
