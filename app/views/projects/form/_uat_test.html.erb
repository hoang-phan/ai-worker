<fieldset class="field">
  <legend>UAT test by the agent (optional)</legend>
  <p class="field-hint">Jira projects only. When the post-merge update moves a ticket to UAT, the agent waits the delay below, then opens the UAT site in a headless browser, runs the ticket's "How to test" steps, records a video and trace, attaches them to the ticket and posts the result as a comment. Needs <code>JIRA_EMAIL</code> and <code>JIRA_ACCESS_TOKEN</code> in <code>.env</code> for the attachments. Use a low-privilege test account, never production.</p>

  <div class="field">
    <label><%= f.check_box :uat_test_enabled %> Test tickets on UAT automatically</label>
  </div>

  <div class="field">
    <%= f.label :uat_url, "UAT URL" %>
    <%= f.text_field :uat_url, placeholder: "https://uat.example.com" %>
  </div>

  <div class="field">
    <%= f.label :uat_instructions, "UAT-only instructions (optional)" %>
    <%= f.text_area :uat_instructions, rows: 6, placeholder: "e.g. Read the guide at /Users/you/code/scout-testing-guide/README.md and follow it for login and test data." %>
    <p class="field-hint">Free text added to the agent's UAT prompt: how to log in, what data to prepare, a guide to read, things to avoid. Anything goes; it can point at a file, folder or URL.</p>
  </div>

  <div class="field">
    <%= f.label :uat_username, "UAT username" %>
    <%= f.text_field :uat_username, autocomplete: "off" %>
  </div>

  <div class="field">
    <%= f.label :uat_password, "UAT password" %>
    <%= f.password_field :uat_password, value: nil, autocomplete: "new-password", placeholder: (f.object.uat_password.present? ? "Saved (leave blank to keep)" : nil) %>
    <p class="field-hint">Stored encrypted. It is handed to the agent as an environment variable for the test run.</p>
  </div>

  <div class="field">
    <%= f.label :uat_test_delay_minutes, "Wait after the ticket reaches UAT (minutes)" %>
    <%= f.number_field :uat_test_delay_minutes, min: 0 %>
  </div>
</fieldset>
