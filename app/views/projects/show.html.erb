<div class="page-header">
  <div>
    <h1><%= @project.name %></h1>
    <p class="page-header__meta"><%= @project.local_directory %><%= " · #{@project.repo_full_name}".html_safe if @project.repo_full_name.present? %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to "Edit project", edit_project_path(@project), class: "btn btn-secondary" %>
  </div>
</div>

<div class="page-header">
  <h2>Workflows</h2>
  <div class="page-header__actions">
    <%= link_to "New runbook", new_project_workflow_path(@project, kind: "runbook"), class: "btn btn-secondary" %>
    <%= link_to "New workflow", new_project_workflow_path(@project), class: "btn btn-primary" %>
  </div>
</div>

<% if @project.jira? %>
  <%= form_with url: log_time_project_workflows_path(@project), method: :post, id: "time-log-form", class: "batch-bar" do %>
    <span class="text-muted">Log time on selected:</span>
    <% Jira::TimeLogger::PRESET_HOURS.each do |hours| %>
      <button type="submit" name="hours" value="<%= hours %>" class="btn btn-secondary" data-turbo-confirm="Log <%= hours %> h on each selected workflow's Jira ticket?"><%= hours %> h</button>
    <% end %>
  <% end %>
<% end %>

<div class="table-wrap" data-controller="select-all">
  <table>
    <thead>
      <tr>
        <% if @project.jira? %>
          <th><input type="checkbox" aria-label="Select all" data-action="change->select-all#toggle" form="time-log-form"></th>
        <% end %>
        <th>Position</th>
        <th><%= @project.personal? ? "Task" : "Jira" %></th>
        <% unless @project.personal? %>
          <th>Branch</th>
        <% end %>
        <th>Status</th>
        <th>Current stage</th>
        <% unless @project.personal? %>
          <th>PR</th>
        <% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @workflows.each do |workflow| %>
        <tr>
          <% if @project.jira? %>
            <td><% if workflow.development? %><input type="checkbox" name="workflow_ids[]" value="<%= workflow.id %>" form="time-log-form" data-select-all-target="row" aria-label="Select <%= workflow.label %>"><% end %></td>
          <% end %>
          <td class="numeric">
            <%= workflow.position %>
            <%= button_to "↑", move_project_workflow_path(@project, workflow, direction: "up"), method: :post, class: "link-action", title: "Move up (higher priority)", disabled: workflow == @workflows.first, form: { style: "display:inline" } %>
            <%= button_to "↓", move_project_workflow_path(@project, workflow, direction: "down"), method: :post, class: "link-action", title: "Move down (lower priority)", disabled: workflow == @workflows.last, form: { style: "display:inline" } %>
          </td>
          <td><%= link_to(truncate(workflow.label, length: 60), project_workflow_path(@project, workflow)) %><%= content_tag(:span, "review", class: "badge badge-neutral") if workflow.pr_review? %><%= content_tag(:span, "runbook", class: "badge badge-neutral") if workflow.runbook? %></td>
          <% unless @project.personal? %>
            <td class="text-muted"><%= workflow.branch_name %></td>
          <% end %>
          <td>
            <%= workflow_status_badge(workflow) %>
          </td>
          <td><%= workflow.runbook? ? (workflow.current_stage&.display_name || workflow.status) : (workflow.current_stage&.stage_type || workflow.status) %></td>
          <% unless @project.personal? %>
            <td><%= link_to "View PR", workflow.github_pr_url, target: "_blank", rel: "noopener", class: "link-action" if workflow.github_pr_url.present? %></td>
          <% end %>
          <td>
            <% if workflow.pending? %>
              <%= button_to "Start", start_project_workflow_path(@project, workflow), method: :post, class: "link-action", form: { style: "display:inline" } %>
            <% end %>
            <%= link_to "Edit", edit_project_workflow_path(@project, workflow), class: "link-action" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @workflows.empty? %>
    <div class="empty-state">No workflows yet. <%= link_to "Create one", new_project_workflow_path(@project) %>.</div>
  <% end %>
</div>

<% if @project.jira? %>
  <%= render "projects/jira_syncs", project: @project %>
<% end %>

<% if @project.jira? %>
  <%= render "projects/bugsnag_syncs", project: @project %>
<% end %>

<% if @project.personal? && (@project.brainstorm_enabled? || @project.brainstorm_goal.present?) %>
  <%= render "projects/brainstorm", project: @project %>
<% end %>

<% if @project.jira? && (@project.slack_review_enabled? || @project.slack_mention.present?) %>
  <%= render "projects/slack_reviews", project: @project %>
<% end %>
