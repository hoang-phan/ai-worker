<div class="page-header">
  <div>
    <h1><%= @project.name %></h1>
    <p class="page-header__meta"><%= project_header_meta(@project) %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to "Edit project", edit_project_path(@project), class: "btn btn-secondary" %>
  </div>
</div>

<div class="page-header">
  <h2>Workflows</h2>
  <div class="page-header__actions">
    <%= link_to "New runbook", new_project_workflow_path(@project, kind: "runbook"), class: "btn btn-secondary" %>
    <%= link_to "New workflow", new_project_workflow_path(@project), class: "btn btn-primary" %>
  </div>
</div>

<%= render "projects/workflows", project: @project, workflow_list: @workflow_list %>


<% if @project.jira? %>
  <%= render "jira_syncs/list", project: @project %>
  <%= render "bugsnag_syncs/list", project: @project %>
<% end %>

<% if show_brainstorm_section?(@project) %>
  <%= render "projects/brainstorm", project: @project %>
<% end %>

<% if show_slack_reviews_section?(@project) %>
  <%= render "projects/slack_reviews", project: @project %>
<% end %>
