<div class="page-header">
  <div>
    <h1><%= @project.name %></h1>
    <p class="page-header__meta"><%= @project.local_directory %> &middot; <%= @project.repo_full_name %></p>
  </div>
  <div class="page-header__actions">
    <%= link_to "Edit project", edit_project_path(@project), class: "btn btn-secondary" %>
  </div>
</div>

<div class="page-header">
  <h2>Workflows</h2>
  <div class="page-header__actions">
    <%= link_to "New workflow", new_project_workflow_path(@project), class: "btn btn-primary" %>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Position</th>
        <th>Jira</th>
        <th>Branch</th>
        <th>Status</th>
        <th>Current stage</th>
        <th>PR</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @workflows.each do |workflow| %>
        <tr>
          <td class="numeric"><%= workflow.position %></td>
          <td><%= link_to workflow.jira_ticket, project_workflow_path(@project, workflow) %></td>
          <td class="text-muted"><%= workflow.branch_name %></td>
          <td>
            <% status_badge = case workflow.status
               when "done" then "badge-success"
               when "implementing", "reviewing" then "badge-info"
               else "badge-neutral"
               end %>
            <span class="badge <%= status_badge %>"><%= workflow.status %></span>
          </td>
          <td><%= workflow.current_stage&.stage_type || workflow.status %></td>
          <td><%= link_to "View PR", workflow.github_pr_url, target: "_blank", rel: "noopener", class: "link-action" if workflow.github_pr_url.present? %></td>
          <td><%= link_to "Edit", edit_project_workflow_path(@project, workflow), class: "link-action" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @workflows.empty? %>
    <div class="empty-state">No workflows yet. <%= link_to "Create one", new_project_workflow_path(@project) %>.</div>
  <% end %>
</div>
