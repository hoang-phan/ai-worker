<%= form_with url: log_time_project_workflows_path(project), method: :post, id: "workflow-selection-form", class: "batch-bar" do %>
  <span class="text-muted" data-bulk-delete-target="count">0 selected</span>
  <button type="button" class="btn btn-secondary" data-action="range-select#selectAll">Select all</button>
  <% if project.jira? %>
    <button type="button" class="btn btn-secondary" data-action="range-select#selectFresh">Select all non time logged</button>
    <span class="text-muted">Log time on selected:</span>
    <% Jira::TimeLogger::PRESET_HOURS.each do |hours| %>
      <button type="submit" name="hours" value="<%= hours %>" class="btn btn-secondary" data-bulk-delete-target="logTime" data-turbo-confirm="Log <%= hours %> h on each selected workflow's Jira ticket?" disabled><%= hours %> h</button>
    <% end %>
  <% end %>
  <button type="submit" name="_method" value="delete" formaction="<%= bulk_destroy_project_workflows_path(project, status: workflow_list.status_filter) %>" class="btn btn-secondary" data-bulk-delete-target="submit" disabled>Delete selected</button>
<% end %>
