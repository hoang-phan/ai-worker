  <tr>
    <% if project.jira? %>
      <td><% if workflow.development? %><%= tag.input type: "checkbox", name: "workflow_ids[]", value: workflow.id, form: "time-log-form", data: time_log_checkbox_data(logged_seconds), aria: { label: "Select #{workflow.label}" } %><% end %></td>
    <% end %>
    <td class="numeric">
      <%= workflow.position %>
      <%= button_to "↑", move_project_workflow_path(project, workflow, direction: "up", status: status_filter), method: :post, class: "link-action", title: "Move up (higher priority)", disabled: workflow == first, form: { style: "display:inline" } %>
      <%= button_to "↓", move_project_workflow_path(project, workflow, direction: "down", status: status_filter), method: :post, class: "link-action", title: "Move down (lower priority)", disabled: workflow == last, form: { style: "display:inline" } %>
    </td>
    <td><%= link_to(truncate(workflow.label, length: 60), project_workflow_path(project, workflow)) %><%= workflow_kind_badges(workflow) %></td>
    <% if project.jira? %>
      <td>
        <%= workflow_logged_time_badge(workflow, logged_seconds) %>
      </td>
    <% end %>
    <td>
      <%= workflow_status_badge(workflow) %>
    </td>
    <% unless project.personal? %>
      <td>
        <% if workflow.github_pr_url.present? %>
          <%= link_to workflow.github_pr_url, target: "_blank", rel: "noopener", class: "icon-button", aria: { label: "Open pull request for #{workflow.label}" }, title: "Open pull request" do %>
            <%= icon_svg(:external_link) %>
          <% end %>
        <% end %>
      </td>
    <% end %>
    <td class="actions-cell">
      <% if workflow.pending? %>
        <%= button_to "Start", start_project_workflow_path(project, workflow, status: status_filter), method: :post, class: "link-action", form: { style: "display:inline" } %>
      <% end %>
      <%= link_to edit_project_workflow_path(project, workflow), class: "icon-button", aria: { label: "Edit #{workflow.label}" }, title: "Edit workflow" do %>
        <%= icon_svg(:edit) %>
      <% end %>
    </td>
  </tr>
