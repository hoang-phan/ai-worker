<div class="card form-card" data-controller="skill-insert">
  <%= form_with model: project do |f| %>
    <%= render "shared/error_summary", record: project %>

    <%= render "projects/form/general", f: f, project: project %>
    <%= render "projects/form/instructions", f: f %>
    <%= render "projects/form/jira", f: f %>
    <%= render "projects/form/uat_test", f: f %>
    <%= render "projects/form/ci_loop", f: f %>
    <%= render "projects/form/local_test", f: f %>
    <%= render "projects/form/brainstorm", f: f %>
    <%= render "projects/form/slack", f: f %>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
