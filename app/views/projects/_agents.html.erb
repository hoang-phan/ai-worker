<div class="page-header">
  <h2>Agents</h2>
  <div class="page-header__actions">
    <%= link_to "New agent", new_project_agent_path(project), class: "btn btn-primary" %>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Model</th>
        <th>Effort</th>
        <th>Hands work to</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% project.agents.includes(:delegates).order(:name).each do |agent| %>
        <tr>
          <td><%= agent.name %></td>
          <td class="text-muted"><%= agent.description %></td>
          <td><%= agent.model.presence || "CLI default" %></td>
          <td><%= agent.effort.presence || "CLI default" %></td>
          <td class="text-muted"><%= agent.delegates.map(&:name).sort.join(", ") %></td>
          <td>
            <%= link_to "Edit", edit_project_agent_path(project, agent), class: "link-action" %>
            <%= link_to "Delete", project_agent_path(project, agent), class: "link-danger", data: { turbo_method: :delete, turbo_confirm: "Delete agent #{agent.name}?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if project.agents.empty? %>
    <div class="empty-state">No agents yet. <%= link_to "Add one", new_project_agent_path(project) %> for a feature or area of this project that stages can run as a specialist.</div>
  <% end %>
</div>
