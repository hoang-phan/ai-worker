<div class="page-header">
  <h2>Brainstorm</h2>
  <div class="page-header__actions">
    <%= button_to "Brainstorm now", brainstorm_project_path(project), class: "btn btn-secondary" %>
  </div>
</div>

<div class="card">
  <div class="field">
    <label>Goal</label>
    <p><%= project.brainstorm_goal.presence || "not set" %> &middot; <%= project.brainstorm_enabled? ? "automatic every hour while no workflow is pending" : "automatic brainstorm off" %></p>
  </div>
  <div class="field">
    <label>Last run</label>
    <p class="text-muted"><%= last_run_summary(project.brainstorm_last_run_at, project.brainstorm_last_result) %> &middot; <%= project.workflows.queued.count %> pending</p>
  </div>
</div>
