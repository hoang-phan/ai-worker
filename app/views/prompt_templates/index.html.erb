<div class="page-header">
  <h1>Prompt templates</h1>
  <div class="page-header__actions">
    <%= link_to "New template", new_prompt_template_path, class: "btn btn-primary" %>
  </div>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Stage type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @prompt_templates.each do |template| %>
        <tr>
          <td><%= link_to template.name, template %></td>
          <td><%= template.stage_type %></td>
          <td>
            <div class="actions-cell">
              <%= link_to "Edit", edit_prompt_template_path(template), class: "link-action" %>
              <%= link_to "Delete", template, class: "link-action link-danger", data: { turbo_method: :delete, turbo_confirm: "Delete template #{template.name}?" } %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @prompt_templates.empty? %>
    <div class="empty-state">No prompt templates yet. <%= link_to "Create one", new_prompt_template_path %>.</div>
  <% end %>
</div>
