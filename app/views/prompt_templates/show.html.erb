<div class="page-header">
  <div>
    <h1><%= @prompt_template.name %></h1>
    <p class="page-header__meta">
      <span class="badge badge-info"><%= @prompt_template.stage_type %></span>
      <span>Model: <%= @prompt_template.model.presence || "CLI default" %></span>
      <span>Effort: <%= @prompt_template.effort.presence || "CLI default" %></span>
    </p>
  </div>
  <div class="page-header__actions">
    <%= link_to "Edit", edit_prompt_template_path(@prompt_template), class: "btn btn-secondary" %>
  </div>
</div>

<div class="code-block"><%= @prompt_template.body %></div>
