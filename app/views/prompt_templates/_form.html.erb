<div class="card form-card">
  <%= form_with model: prompt_template do |f| %>
    <%= render "shared/error_summary", record: f.object, noun: "template" %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>

    <div class="field">
      <%= f.label :stage_type %>
      <%= f.select :stage_type, PromptTemplate.stage_types.keys %>
    </div>

    <div class="field">
      <%= f.label :model %>
      <%= f.text_field :model, placeholder: "claude-sonnet-5-5 (blank = CLI default)" %>
    </div>

    <div class="field">
      <%= f.label :effort %>
      <%= f.select :effort, PromptTemplate::EFFORTS, include_blank: "CLI default" %>
    </div>

    <div class="field">
      <%= f.label :body %>
      <div class="placeholder-list">
        <% Prompts::Renderer::BUILT_IN_TOKENS.each do |placeholder| %>
          <span class="placeholder-chip"><%= placeholder %></span>
        <% end %>
      </div>
      <%= f.text_area :body, rows: 20 %>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
