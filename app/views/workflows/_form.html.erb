<div class="card form-card" data-controller="skill-insert">
  <%= form_with model: [project, workflow] do |f| %>
    <% if workflow.errors.any? %>
      <div class="error-summary">
        <strong><%= pluralize(workflow.errors.count, "error") %> prevented this workflow from saving:</strong>
        <ul>
          <% workflow.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if workflow.pr_review? %>
      <p class="field-hint">Review workflows are created from Slack mentions: <%= workflow.label %>.</p>
    <% elsif workflow.runbook? %>
      <%= render "workflows/form/runbook_fields", f: f, workflow: workflow, project: project %>
    <% elsif project.personal? %>
      <%= render "workflows/form/task_fields", f: f, workflow: workflow, project: project %>
    <% else %>
      <%= render "workflows/form/jira_fields", f: f, workflow: workflow, project: project %>
    <% end %>

    <% unless workflow.pr_review? || workflow.runbook? %>
      <%= render "workflows/form/images", f: f, workflow: workflow, project: project %>
    <% end %>

    <div class="field">
      <%= f.label :position %>
      <%= f.number_field :position %>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
