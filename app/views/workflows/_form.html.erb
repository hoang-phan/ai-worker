<div class="card form-card" data-controller="skill-insert">
  <%= form_with model: [project, workflow] do |f| %>
    <% if workflow.errors.any? %>
      <div class="error-summary">
        <strong><%= pluralize(workflow.errors.count, "error") %> prevented this workflow from saving:</strong>
        <ul>
          <% workflow.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if workflow.pr_review? %>
      <p class="field-hint">Review workflows are created from Slack mentions: <%= workflow.label %>.</p>
    <% elsif workflow.runbook? %>
      <%= hidden_field_tag "workflow[kind]", "runbook" %>
      <div class="field">
        <%= f.label :variables_text, "Variables (one NAME=value per line)" %>
        <%= f.text_area :variables_text, rows: 5, placeholder: "VERSION=\nENV=prod\nRELEASE_DATE=" %>
        <p class="field-hint">Each name becomes a <code>{NAME}</code> placeholder in stage prompts and messages. Stages can also set them while running.</p>
      </div>
      <% unless workflow.persisted? %>
        <% sources = project.workflows.runbook.order(id: :desc) %>
        <% if sources.any? %>
          <div class="field">
            <%= f.label :copy_stages_from_id, "Start with the stages of" %>
            <%= f.select :copy_stages_from_id, sources.map { |source| [ "##{source.id} #{source.label} (#{source.status})", source.id ] }, include_blank: "Nothing (add stages afterwards)" %>
            <p class="field-hint">Copies the stage list so each deployment keeps its own; edit it freely afterwards.</p>
          </div>
        <% end %>
      <% end %>
    <% elsif project.personal? %>
      <div class="field">
        <%= f.label :task_description, "What needs to be done" %>
        <%= render "shared/skill_hints", project: project %>
        <%= f.text_area :task_description, rows: 6, data: { skill_insert_target: "input" } %>
      </div>
    <% else %>
      <div class="field">
        <%= f.label :jira_ticket %>
        <%= f.text_field :jira_ticket %>
      </div>

      <div class="field">
        <%= f.label :branch_name %>
        <%= f.text_field :branch_name %>
      </div>

      <div class="field">
        <%= f.label :github_reviewer, "GitHub reviewers (usernames, comma-separated; any one approval completes review)" %>
        <%= f.text_field :github_reviewer %>
      </div>

      <div class="field">
        <%= f.label :skills, "Skills to use (comma-separated)" %>
        <%= render "shared/skill_hints", project: project %>
        <%= f.text_area :skills, rows: 3, data: { skill_insert_target: "input" } %>
      </div>
    <% end %>

    <% unless workflow.pr_review? || workflow.runbook? %>
      <div class="field">
        <%= f.label :images, "Reference images (available to the agent via {IMAGES})" %>
        <%= f.file_field :images, multiple: true, accept: "image/*" %>
        <% if workflow.persisted? %>
          <% workflow.image_paths.each do |path| %>
            <p>
              <%= File.basename(path) %>
              <%= link_to "Remove", image_project_workflow_path(project, workflow, name: File.basename(path)), class: "link-danger", data: { turbo_method: :delete } %>
            </p>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :position %>
      <%= f.number_field :position %>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
