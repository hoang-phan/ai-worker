<div class="field">
  <%= f.label :jira_ticket %>
  <%= f.text_field :jira_ticket %>
</div>

<div class="field">
  <%= f.label :branch_name %>
  <%= f.text_field :branch_name %>
</div>

<div class="field">
  <%= f.label :github_reviewer, "GitHub reviewers (usernames, comma-separated; any one approval completes review)" %>
  <%= f.text_field :github_reviewer %>
</div>

<%= render "shared/skills_field", f: f, attribute: :skills, label: "Skills to use (comma-separated)", rows: 3, project: project %>

<% if project.ci_loop_ready? %>
  <%= render "shared/skills_field", f: f, attribute: :pr_skills, label: "PR skills (comma-separated)", rows: 2, project: project,
                                    hint: safe_join(["Only the PR stage uses these (", tag.code("{PR_SKILLS}"), ")."]) %>
<% end %>

<div class="field">
  <%= f.label :slack_review_thread_ts, "Slack review thread (optional)" %>
  <%= f.text_field :slack_review_thread_ts, placeholder: "https://workspace.slack.com/archives/C0B5XFY2F0T/p1760000000123456" %>
  <p class="field-hint">Paste a Slack message link to use an existing thread: review requests and re-reviews are posted as replies in it. Left empty, the first review message starts the thread and is saved here. Replies go to the project's review channel, so the thread must be in it.</p>
</div>
