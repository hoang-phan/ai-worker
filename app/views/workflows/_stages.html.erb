<div class="page-header">
  <h2>Stages</h2>
  <% if workflow.runbook? %>
    <div class="page-header__actions">
      <%= link_to "Add stage", new_project_workflow_stage_path(project, workflow), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<% current_stage = workflow.current_stage %>
<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= workflow.runbook? ? "Stage" : "Type" %></th>
        <th></th>
        <th><%= workflow.runbook? ? "Channel" : "Template" %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% workflow.stages.each do |stage| %>
        <% stage_badge = current_stage_badge(workflow, stage, current_stage) %>
        <tr>
          <td>
            <%= workflow.runbook? ? stage.display_name : stage.stage_type %>
            <%= content_tag(:span, stage.run_mode, class: "badge badge-neutral") if workflow.runbook? %>
            <%= content_tag(:span, "waits for #{stage.wait_for_workflow}", class: "badge badge-neutral") if stage.wait_for_workflow.present? %>
            <%= content_tag(:span, stage.auto_advance? ? "→ auto" : "⏸ then Next", class: "badge badge-neutral") if workflow.runbook? %>
          </td>
          <td><%= content_tag(:span, stage_badge, class: "badge badge-info") if stage_badge %></td>
          <td><%= workflow.runbook? ? stage.channel : stage.effective_template&.name %></td>
          <td>
            <% if stage_runnable?(workflow, stage, current_stage) %>
              <%= button_to "Run", run_stage_project_workflow_path(project, workflow), method: :post, class: "btn btn-primary", form: { style: "display:inline" } %>
            <% end %>
            <%= link_to "Edit", edit_project_workflow_stage_path(project, workflow, stage), class: "btn btn-secondary" %>
            <% if workflow.runbook? %>
              <%= link_to "Remove", project_workflow_stage_path(project, workflow, stage), class: "btn btn-secondary link-danger", data: { turbo_method: :delete, turbo_confirm: "Remove this stage?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
