<p class="page-header__meta"><%= link_to @project.name, @project %></p>

<div class="page-header">
  <div>
    <h1><%= @workflow.runbook? ? @workflow.label : @workflow.pr_review? ? "Review #{@workflow.label}" : (@project.personal? ? "Task ##{@workflow.id}" : @workflow.jira_ticket) %></h1>
  </div>
  <div class="page-header__actions">
    <% if @workflow.pending? %>
      <%= button_to "Start", start_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.runbook? && @workflow.awaiting_next? %>
      <%= button_to (@workflow.next_runbook_stage ? "Next: #{@workflow.next_runbook_stage.display_name}" : "Finish"), advance_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.errored? %>
      <%= button_to "Resume", resume_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.done? && @workflow.development? && @workflow.github_pr_url.present? %>
      <%= button_to "Roll back to review", rollback_to_review_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { data: { turbo_confirm: "Move this workflow back to the review stage?" } } %>
    <% end %>
    <% if @workflow.runbook? %>
      <%= button_to "Clone", clone_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { style: "display:inline" } %>
    <% end %>
    <%= link_to "Edit", edit_project_workflow_path(@project, @workflow), class: "btn btn-secondary" %>
    <%= link_to "Delete", project_workflow_path(@project, @workflow), class: "btn btn-secondary link-danger", data: { turbo_method: :delete, turbo_confirm: "Delete this workflow?" } %>
  </div>
</div>

<div class="card">
  <% if @workflow.pr_review? %>
    <% if @workflow.slack_url.present? %>
      <div class="field">
        <label>Slack message</label>
        <p><%= link_to @workflow.slack_url, @workflow.slack_url, target: "_blank", rel: "noopener" %></p>
      </div>
    <% end %>
  <% elsif @workflow.runbook? %>
    <% @workflow.variables.each do |name, value| %>
      <div class="field">
        <label><%= name %></label>
        <p><%= value %></p>
      </div>
    <% end %>
  <% elsif @project.personal? %>
    <div class="field">
      <label>Task</label>
      <p><%= @workflow.task_description %></p>
    </div>
  <% else %>
    <div class="field">
      <label>Branch</label>
      <p><%= @workflow.branch_name %></p>
    </div>
    <div class="field">
      <label>Reviewer</label>
      <p><%= @workflow.github_reviewer %></p>
    </div>
    <div class="field">
      <label>Skills</label>
      <p><%= @workflow.skill_list.join(", ") %></p>
    </div>
  <% end %>
  <% if @workflow.image_paths.any? %>
    <div class="field">
      <label>Reference images</label>
      <% @workflow.image_paths.each do |path| %>
        <p class="text-muted"><%= path %></p>
      <% end %>
    </div>
  <% end %>
  <div class="field">
    <label>Status</label>
    <%= workflow_status_badge(@workflow) %>
    <% if @workflow.uat_waiting? && @workflow.uat_test_at %>
      <span class="text-muted">agent UAT test starts <%= l @workflow.uat_test_at, format: :short %></span>
    <% end %>
  </div>
  <% if @project.jira? && @workflow.development? %>
    <div class="field">
      <label>Log time (<%= number_with_precision(@workflow.time_logs.sum(:seconds) / 3600.0, precision: 2, strip_insignificant_zeros: true) %> h logged)</label>
      <%= form_with url: log_time_project_workflows_path(@project), method: :post, class: "batch-bar" do %>
        <%= hidden_field_tag "workflow_ids[]", @workflow.id %>
        <% Jira::TimeLogger::PRESET_HOURS.each do |hours| %>
          <button type="submit" name="hours" value="<%= hours %>" class="btn btn-secondary"><%= hours %> h</button>
        <% end %>
      <% end %>
    </div>
  <% end %>
  <% if @workflow.github_pr_url.present? %>
    <div class="field">
      <label>Pull request</label>
      <p><%= link_to @workflow.github_pr_url, @workflow.github_pr_url, target: "_blank", rel: "noopener" %></p>
    </div>
  <% end %>
</div>

<div class="page-header">
  <h2>Stages</h2>
  <% if @workflow.runbook? %>
    <div class="page-header__actions">
      <%= link_to "Add stage", new_project_workflow_stage_path(@project, @workflow), class: "btn btn-secondary" %>
    </div>
  <% end %>
</div>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th><%= @workflow.runbook? ? "Stage" : "Type" %></th>
        <th></th>
        <th><%= @workflow.runbook? ? "Channel" : "Template" %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @workflow.stages.each do |stage| %>
        <tr>
          <td>
            <%= @workflow.runbook? ? stage.display_name : stage.stage_type %>
            <%= content_tag(:span, stage.run_mode, class: "badge badge-neutral") if @workflow.runbook? %>
            <%= content_tag(:span, "waits for #{stage.wait_for_workflow}", class: "badge badge-neutral") if stage.wait_for_workflow.present? %>
            <%= content_tag(:span, stage.auto_advance? ? "→ auto" : "⏸ then Next", class: "badge badge-neutral") if @workflow.runbook? %>
          </td>
          <td><%= content_tag(:span, @workflow.waiting? ? "waiting for Next" : "current", class: "badge badge-info") if @workflow.current_stage == stage %></td>
          <td><%= @workflow.runbook? ? stage.channel : stage.effective_template&.name %></td>
          <td>
            <% if @workflow.runbook? && @workflow.implementing? && !@workflow.processing? && @workflow.current_stage == stage %>
              <%= button_to "Run", run_stage_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary", form: { style: "display:inline" } %>
            <% end %>
            <%= link_to "Edit", edit_project_workflow_stage_path(@project, @workflow, stage), class: "btn btn-secondary" %>
            <% if @workflow.runbook? %>
              <%= link_to "Remove", project_workflow_stage_path(@project, @workflow, stage), class: "btn btn-secondary link-danger", data: { turbo_method: :delete, turbo_confirm: "Remove this stage?" } %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<h2>Stage run history</h2>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th>When</th>
        <th>Action</th>
        <th>Output</th>
        <th>Error</th>
      </tr>
    </thead>
    <tbody>
      <% @stage_runs.each do |run| %>
        <tr>
          <td class="text-muted"><%= run.created_at %></td>
          <td><%= run.action %></td>
          <td class="text-muted"><%= truncate(run.output, length: 200) %></td>
          <td><%= content_tag(:span, run.error, class: "text-muted") if run.error.present? %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @stage_runs.empty? %>
    <div class="empty-state">No stage runs yet.</div>
  <% end %>
</div>
