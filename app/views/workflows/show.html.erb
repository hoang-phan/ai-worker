<p class="page-header__meta"><%= link_to @project.name, @project %></p>

<div class="page-header">
  <div>
    <h1><%= @workflow.heading %></h1>
  </div>
  <div class="page-header__actions">
    <% if @workflow.pending? %>
      <%= button_to "Start", start_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.can_advance? %>
      <%= button_to workflow_advance_label(@workflow), advance_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.errored? %>
      <%= button_to "Resume", resume_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.can_rollback_to_review? %>
      <%= button_to "Roll back to review", rollback_to_review_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { data: { turbo_confirm: "Move this workflow back to the review stage?" } } %>
    <% end %>
    <% if @workflow.can_skip_stage? %>
      <%= button_to "Skip stage", skip_stage_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { data: { turbo_confirm: "Skip this stage and move on to the next one?" } } %>
    <% end %>
    <% if @workflow.runbook? %>
      <%= inline_button_to "Clone", clone_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary" %>
    <% end %>
    <%= link_to "Edit", edit_project_workflow_path(@project, @workflow), class: "btn btn-secondary" %>
    <%= delete_link_to "Delete", project_workflow_path(@project, @workflow), class: "btn btn-secondary link-danger", confirm: "Delete this workflow?" %>
  </div>
</div>

<%= render "details", project: @project, workflow: @workflow %>

<%= render "stages", project: @project, workflow: @workflow %>

<%= render "stage_runs", stage_runs: @stage_runs %>
