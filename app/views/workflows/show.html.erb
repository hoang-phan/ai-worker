<p class="page-header__meta"><%= link_to @project.name, @project %></p>

<div class="page-header">
  <div>
    <h1><%= @workflow.heading %></h1>
  </div>
  <div class="page-header__actions">
    <% if @workflow.pending? %>
      <%= button_to "Start", start_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.runbook? && @workflow.awaiting_next? %>
      <%= button_to (@workflow.next_runbook_stage ? "Next: #{@workflow.next_runbook_stage.display_name}" : "Finish"), advance_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.errored? %>
      <%= button_to "Resume", resume_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-primary" %>
    <% end %>
    <% if @workflow.done? && @workflow.development? && @workflow.github_pr_url.present? %>
      <%= button_to "Roll back to review", rollback_to_review_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { data: { turbo_confirm: "Move this workflow back to the review stage?" } } %>
    <% end %>
    <% if @workflow.runbook? %>
      <%= button_to "Clone", clone_project_workflow_path(@project, @workflow), method: :post, class: "btn btn-secondary", form: { style: "display:inline" } %>
    <% end %>
    <%= link_to "Edit", edit_project_workflow_path(@project, @workflow), class: "btn btn-secondary" %>
    <%= link_to "Delete", project_workflow_path(@project, @workflow), class: "btn btn-secondary link-danger", data: { turbo_method: :delete, turbo_confirm: "Delete this workflow?" } %>
  </div>
</div>

<%= render "details", project: @project, workflow: @workflow, jira_logged_seconds: @jira_logged_seconds, jira_logged_error: @jira_logged_error %>

<%= render "stages", project: @project, workflow: @workflow %>

<%= render "stage_runs", stage_runs: @stage_runs %>
