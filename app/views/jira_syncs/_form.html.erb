<div class="card form-card">
  <%= form_with model: [project, jira_sync] do |f| %>
    <%= render "shared/error_summary", record: f.object, noun: "sync" %>

    <div class="field">
      <%= f.label :jira_project, "Jira project (optional)" %>
      <%= f.text_field :jira_project, placeholder: "UNS, project URL or project name" %>
    </div>

    <div class="field">
      <%= f.label :parent_ticket, "Parent ticket (optional)" %>
      <%= f.text_field :parent_ticket, placeholder: "UIUX-100, ticket URL or title" %>
      <p class="field-hint">Leave both blank to pull every "To Do" ticket assigned to the project's Jira assignee. New tickets become pending workflows (never auto-started).</p>
    </div>

    <div class="field">
      <label><%= f.check_box :auto_sync %> Sync automatically on a schedule</label>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
