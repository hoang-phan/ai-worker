<% noun = local_assigns.fetch(:noun, record.model_name.human.downcase) %>
<% if record.errors.any? %>
  <div class="error-summary">
    <strong><%= pluralize(record.errors.count, "error") %> prevented this <%= noun %> from saving:</strong>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
