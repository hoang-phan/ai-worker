<div class="card form-card">
  <%= form_with model: [project, definition] do |f| %>
    <% if definition.errors.any? %>
      <div class="error-summary">
        <strong><%= pluralize(definition.errors.count, "error") %> prevented this stage from saving:</strong>
        <ul>
          <% definition.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :name %>
      <%= f.text_field :name %>
    </div>

    <div class="field">
      <%= f.label :position %>
      <%= f.number_field :position %>
    </div>

    <div class="field">
      <%= f.label :run_mode, "What the stage does" %>
      <%= f.select :run_mode, StageDefinition.run_modes.keys.map { |m| [ m == "agent" ? "Run the prompt with the agent" : "Post the text to Slack", m ] } %>
    </div>

    <div class="field">
      <%= f.label :channel, "Slack channel (message stages)" %>
      <%= f.text_field :channel, placeholder: "#client-success-and-product-teams" %>
    </div>

    <div class="field">
      <%= f.label :prompt, "Prompt / message text" %>
      <p class="field-hint">Placeholders: <%= (PromptTemplate::PLACEHOLDERS + project.variable_defaults.keys.map { |k| "{#{k}}" }).join(" ") %>. An agent stage can pass values on by printing <code>VAR: NAME=value</code>.</p>
      <%= f.text_area :prompt, rows: 12 %>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
