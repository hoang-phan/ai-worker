<div class="page-header">
  <h1>Settings</h1>
</div>

<div class="card form-card">
  <%= form_with url: settings_path, method: :patch do |f| %>
    <div class="field">
      <%= f.label :agent, "Agent" %>
      <%= f.select :agent, AiCli::Runner.available_agents, selected: @agent %>
      <p class="text-muted">The CLI used for all runs. Takes effect on the next run; runs already in progress keep their agent. Falls back to the AGENT env var until set here.</p>
    </div>

    <div class="form-actions">
      <%= f.submit "Save" %>
    </div>
  <% end %>
</div>
