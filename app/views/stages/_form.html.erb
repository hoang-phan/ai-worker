<div
  class="card form-card"
  id="stage-prompt-context"
  data-placeholders="<%= Prompts::Renderer.placeholders_for(workflow).to_json %>"
>
  <%= form_with model: [project, workflow, stage] do |f| %>
    <% if stage.errors.any? %>
      <div class="error-summary">
        <strong><%= pluralize(stage.errors.count, "error") %> prevented this stage from saving:</strong>
        <ul>
          <% stage.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if workflow.runbook? %>
      <div class="field">
        <%= f.label :name %>
        <%= f.text_field :name %>
      </div>
      <div class="field">
        <%= f.label :position %>
        <%= f.number_field :position %>
      </div>
      <div class="field">
        <%= f.label :run_mode, "What the stage does" %>
        <%= f.select :run_mode, Stage.run_modes.keys.map { |m| [ m == "agent" ? "Run the prompt with the agent" : "Post the text to Slack", m ] } %>
      </div>
      <div class="field">
        <%= f.label :channel, "Slack channel (message stages)" %>
        <%= f.text_field :channel %>
      </div>
      <div class="field">
        <%= f.label :auto_advance, "Continue automatically after this stage" %>
        <%= f.check_box :auto_advance %>
        <p class="field-hint">Unticked, the runbook stops here until someone clicks Next (a decision point). Ticked, the next stage starts by itself.</p>
      </div>
      <div class="field">
        <%= f.label :wait_for_workflow, "Wait for GitHub Actions workflow (optional)" %>
        <%= f.text_field :wait_for_workflow, placeholder: "manual_environment_deploy.yml" %>
        <p class="field-hint">The stage won't start until the latest run of this workflow (started after the previous stage began) has finished successfully; it fails if that run fails.</p>
      </div>
    <% end %>

    <div class="field">
      <%= f.label :prompt_template_id, "Prompt template" %>
      <%= f.select :prompt_template_id,
            options_for_select(
              stage.candidate_templates.map { |t| [t.name, t.id, { data: { body: t.body } }] },
              stage.prompt_template_id
            ),
            include_blank: "Use default template for #{stage.stage_type}" %>
      <p class="field-hint">Selecting a template fills in the prompt below with this workflow's details &mdash; edit it freely before saving.</p>
    </div>

    <div class="field">
      <%= f.label :prompt %>
      <% skill_names = project_skill_names(project) %>
      <% if skill_names.any? %>
        <div class="placeholder-list">
          <% skill_names.each do |skill| %>
            <button type="button" class="placeholder-chip skill-chip" data-skill="<%= skill %>">/<%= skill %></button>
          <% end %>
        </div>
        <p class="field-hint">Click a skill to insert it at the cursor.</p>
      <% else %>
        <p class="field-hint">No skills found in <code><%= File.join(File.expand_path(project.local_directory.to_s), ".agents", "skills") %></code>.</p>
      <% end %>
      <%= f.text_area :prompt, rows: 20 %>
    </div>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>

<script>
  (function () {
    var context = document.getElementById("stage-prompt-context");
    var select = document.getElementById("stage_prompt_template_id");
    var textarea = document.getElementById("stage_prompt");
    if (!context || !select || !textarea) return;

    var placeholders = JSON.parse(context.dataset.placeholders || "{}");

    select.addEventListener("change", function () {
      var option = select.options[select.selectedIndex];
      var body = option.dataset.body;
      if (!body) return;

      Object.keys(placeholders).forEach(function (token) {
        body = body.split(token).join(placeholders[token]);
      });

      textarea.value = body;
    });

    document.querySelectorAll(".skill-chip").forEach(function (chip) {
      // keep the textarea's selection when the button is pressed
      chip.addEventListener("mousedown", function (event) { event.preventDefault(); });
      chip.addEventListener("click", function () {
        var text = "/" + chip.dataset.skill;
        var start = textarea.selectionStart;
        var end = textarea.selectionEnd;
        if (typeof start !== "number") { start = end = textarea.value.length; }
        textarea.setRangeText(text, start, end, "end");
        textarea.focus();
      });
    });
  })();
</script>
