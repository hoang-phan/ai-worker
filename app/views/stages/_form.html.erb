<div
  class="card form-card"
  data-controller="skill-insert template-fill"
  data-template-fill-placeholders-value="<%= Prompts::Renderer.placeholders_for(workflow).to_json %>"
>
  <%= form_with model: [project, workflow, stage] do |f| %>
    <%= render "shared/error_summary", record: f.object %>

    <% if workflow.runbook? %>
      <%= render "stages/form/runbook_fields", f: f, stage: stage, workflow: workflow, project: project %>
    <% end %>

    <% if stage.ci_check? %>
      <%= render "stages/form/command_field", f: f, stage: stage, workflow: workflow, project: project %>
    <% else %>
      <%= render "stages/form/prompt_fields", f: f, stage: stage, workflow: workflow, project: project %>
    <% end %>

    <div class="form-actions">
      <%= f.submit %>
    </div>
  <% end %>
</div>
